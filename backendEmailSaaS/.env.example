# ==============================================================================
# FASTAPI EMAIL MICROSERVICE CONFIGURATION (.env)
# ==============================================================================

# 1. PASTE YOUR RESEND API KEY HERE
# Get it for free at: https://resend.com/api-keys (starts with "re_...")
RESEND_API_KEY=re_your_api_key_here

# 2. YOUR EMAIL ADDRESS
# The inbox where you want to receive inquiries sent from your portfolio
RECIPIENT_EMAIL=rdakshesh800@gmail.com

# 3. SENDER IDENTITY
# Note: For free/testing accounts, Resend requires using: "Portfolio Contact <onboarding@resend.dev>"
# Once you add and verify your own domain on Resend, you can change this to:
# "Dakshesh Portfolio <contact@yourdomain.com>"
SENDER_EMAIL=Portfolio Contact <onboarding@resend.dev>

# 4. SERVER PORT
PORT=8001

# 5. ALLOWED CORS ORIGINS (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dakshesh-portfolio.vercel.app

